# Required: absolute path to your Obsidian vault root.
VAULT_ROOT=/Users/yourname/Documents/MyVault

# Optional: relative subpath inside the vault where wiki pages land.
# Default: Coding-Notes
VAULT_NOTES_SUBPATH=Coding-Notes

# Optional: enables the LLM-based MOC description generator.
# When unset, MOC descriptions fall back to a heuristic. The pipeline
# runs fine without this; only index-page summaries improve when set.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: override path to the domains config (default: repo's config/domains.yaml).
# KB_BRAIN_DOMAINS_FILE=/Users/alice/.config/obsidian-kb-pipeline/domains.yaml

# Optional: log level. Default INFO.
# KB_BRAIN_LOG_LEVEL=DEBUG
